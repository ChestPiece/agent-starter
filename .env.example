# Required
OPENAI_API_KEY=

# Optional: text model for chat (unset = the @openai/agents default)
OPENAI_MODEL=
# Optional: voice call model and voice
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin

# Optional: persistent storage. Unset = in-memory (resets on restart, one server only).
# Run supabase/migrations/0001_agent.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
