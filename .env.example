# Required
OPENAI_API_KEY=

# Optional: text model for chat (unset = the @openai/agents default).
# An OpenAI name (gpt-5.6-luna) uses OPENAI_API_KEY.
# "provider/model" (anthropic/claude-sonnet-5-5, see vercel.com/ai-gateway/models) goes through Vercel AI Gateway and needs AI_GATEWAY_API_KEY.
CHAT_MODEL=
AI_GATEWAY_API_KEY=
# Optional: voice call model and voice
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin

# Optional: persistent storage. Unset = in-memory (resets on restart, one server only).
# Run supabase/migrations/0001_agent.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
